class Contact4:
        def __init__(self, name, phone, email):
            self.name = name
            self.phone = phone
            self.email = email
        def __str__(self):
            return f"{self.name} - {self.phone} - {self.email}"

import Contact4
import json
class ContactManager4:
            def __init__(self, filename):
                self.filename = filename
                self.n = 1
                try:
                    with open(self.filename, 'r') as file16:
                        jsonContent = json.load(file16)
                        self.contacts = jsonContent
                except (FileNotFoundError, json.JSONDecodeError):
                    self.contacts = [ ]
                if self.contacts:
                    self.n = max(c["id"] for c in self.contacts) + 1
                else:
                    self.n = 1
            def add_contact(self):
                choiceName = input("What's The Name Of The New Contact?").lower().strip()
                choicePhone = input("Then, What's The Phone Number?").lower().strip()
                choiceEmail = input("Finally, Email?").lower().strip()
                c = Contact4.Contact4(choiceName, choicePhone, choiceEmail)
                dict1 = {"id": self.n, 'name': c.name, 'phone': c.phone, 'email': c.email}
                self.contacts.append(dict1)
                with open(self.filename, 'w') as file16:
                        json.dump(self.contacts, file16)
            def show_all(self):
                    for c in self.contacts:
                            print(c)
            def search(self):
                    found = False
                    choiceMatch = input('Who Do You Wanna Search?').lower().strip()
                    for c in self.contacts:
                            if choiceMatch == c["name"]:
                                    print(c)
                                    found = True
                    if not found:
                        print('Not Found!')
            def delete(self):
                    found2 = False
                    choiceDel = input(f"Who Do You Wanna Delete?").lower().strip()
                    for c in self.contacts:
                        if c["name"] == choiceDel:
                            found2 = True
                    self.contacts = [c for c in self.contacts if c["name"] != choiceDel]
                    with open(self.filename, 'w') as file16:
                        json.dump(self.contacts, file16)
                    if not found2:
                        print('Not Found!')

